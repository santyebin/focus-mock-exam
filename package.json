{
  "name": "focus-mock-exam",
  "version": "2.0.0",
  "private": true,
  "description": "Adaptive mock exam in the GMAT exam format: real-exam screens, section tests, fixed forms, practice, mistake log, progress tracking.",
  "scripts": {
    "check": "node tools/validate-bank.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "build": "node tools/build.js",
    "forms": "node tools/make-forms.js",
    "icons": "node tools/make-icons.js",
    "simulate": "node tools/simulate.js",
    "serve": "python3 -m http.server 8765"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
